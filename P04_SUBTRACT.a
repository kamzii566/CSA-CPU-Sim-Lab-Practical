; ==============================================================
; Practical 4 : SUBTRACT operation on two user-entered numbers
; Machine : BasicComputer.cpu (Mano's Basic Computer)
; Logic : DIFFERENCE = A - B
; ==============================================================

 INP
 STA A
 INP
 CMA
 INC
 ADD A
 STA DIFF
 OUT
 HLT

A: .data 1 0
DIFF: .data 1 0
