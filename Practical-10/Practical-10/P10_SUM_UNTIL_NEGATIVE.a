; ==============================================================
; Practical 10 : Sum of integers until a negative number is read
; Machine : BasicComputer.cpu (Mano's Basic Computer)
; ==============================================================

LOOP: INP
      SPA
      BUN DONE
      ADD SUM
      STA SUM
      BUN LOOP

DONE: LDA SUM
      OUT
      HLT

SUM:  .data 1 0
